# Скопируйте этот файл в .env (рядом с server.js) и впишите свои значения.
# Файл .env не попадает в git — токены остаются только у вас.

# Токен бота от @BotFather
TG_TOKEN=

# Куда слать заявки операторам: id вашего личного чата или группы
TG_CHAT_ID=

# Если VPN включён, а бот пишет ETIMEDOUT: адрес прокси из настроек VPN-программы.
# На Windows системный прокси подхватывается сам; off — не использовать прокси.
# TG_PROXY=http://127.0.0.1:10809

# 1 = бот сам забирает сообщения из Telegram (не нужен домен и webhook)
TG_POLLING=1

# Город по умолчанию для заявок из панели диспетчера
DEFAULT_CITY=Новосибирск

# Пароль для входа в панель диспетчера (если пусто — создастся сам при первом запуске)
ADMIN_PASSWORD=

# Доля компании с каждого выполненного заказа, %
COMMISSION_PERCENT=0

# Сайт для клиентов
SITE_NAME=Мастер на час
SITE_PHONE=

# Ключ Claude для умного разбора заявок (необязательно)
ANTHROPIC_API_KEY=

PORT=3000
