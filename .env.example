# Скопируйте этот файл в .env (рядом с server.js) и впишите свои значения.
# Файл .env не попадает в git — токены остаются только у вас.

# Токен бота от @BotFather
TG_TOKEN=

# Куда слать заявки операторам: id вашего личного чата или группы
TG_CHAT_ID=

# 1 = бот сам забирает сообщения из Telegram (не нужен домен и webhook)
TG_POLLING=1

# Город по умолчанию для заявок из панели диспетчера
DEFAULT_CITY=Новосибирск

# Ключ Claude для умного разбора заявок (необязательно)
ANTHROPIC_API_KEY=

PORT=3000
